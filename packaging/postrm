#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "$1" = purge ]; then
    # Bans already created stay in Cloudflare; lift them first with `cf-ratewatch unban` if needed.
    rm -f /etc/cf-ratewatch/token /etc/cf-ratewatch/influx_token
    rmdir /etc/cf-ratewatch 2>/dev/null || true
    rm -rf /var/lib/cf-ratewatch
fi

exit 0
