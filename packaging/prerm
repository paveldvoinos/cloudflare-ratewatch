#!/bin/sh
set -e

if [ "$1" = remove ]; then
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop cf-ratewatch.timer cf-ratewatch.service >/dev/null 2>&1 || true
    fi
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper disable cf-ratewatch.timer >/dev/null 2>&1 || true
    fi
fi

exit 0
