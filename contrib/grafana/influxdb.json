{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "title": "cf-ratewatch (InfluxDB)",
  "uid": "cf-ratewatch-influx",
  "tags": [
    "cloudflare",
    "cf-ratewatch"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUXDB}"
        },
        "query": "SHOW TAG VALUES FROM \"cf_ratewatch_zone\" WITH KEY = \"zone\"",
        "definition": "SHOW TAG VALUES FROM \"cf_ratewatch_zone\" WITH KEY = \"zone\"",
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Top single-IP requests per window",
      "description": "Highest request count from a single client IP over the counting window, per zone, with the zone's ban threshold as a dashed line. Use it to tune thresholds.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT max(\"top_requests\") FROM \"cf_ratewatch_zone\" WHERE $timeFilter AND \"zone\" =~ /^$zone$/ GROUP BY time($__interval), \"zone\" fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_zone"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"threshold\") FROM \"cf_ratewatch_zone\" WHERE $timeFilter AND \"zone\" =~ /^$zone$/ GROUP BY time($__interval), \"zone\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_zone threshold"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*threshold.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Bans per hour",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT sum(\"bans\") FROM \"cf_ratewatch_zone\" WHERE $timeFilter AND \"zone\" =~ /^$zone$/ GROUP BY time(1h), \"zone\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_zone"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Active bans",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"active_bans\") FROM \"cf_ratewatch_run\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Errors in last run",
      "description": "API errors in the most recent run, including an exhausted analytics budget.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"errors\") FROM \"cf_ratewatch_run\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Last run",
      "description": "When cf-ratewatch last reported. Should be a few minutes ago.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 20,
        "y": 9,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"duration\") FROM \"cf_ratewatch_run\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Time$/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 5
    },
    {
      "type": "table",
      "title": "Recent bans",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT \"ip\", \"hits\", \"until\" FROM \"cf_ratewatch_ban\" WHERE $timeFilter AND \"zone\" =~ /^$zone$/ GROUP BY \"zone\", \"mode\" ORDER BY time DESC LIMIT 200",
          "rawQuery": true,
          "resultFormat": "table",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Top talkers, latest run",
      "description": "Top client IPs per zone from the most recent run (influx_top_ips per zone).",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 14,
        "y": 17,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"requests\") AS \"requests\", last(\"ip\") AS \"ip\" FROM \"cf_ratewatch_top\" WHERE time > now() - 30m AND \"zone\" =~ /^$zone$/ GROUP BY \"zone\", \"rank\"",
          "rawQuery": true,
          "resultFormat": "table",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "requests",
            "desc": true
          }
        ]
      },
      "id": 7
    }
  ]
}
