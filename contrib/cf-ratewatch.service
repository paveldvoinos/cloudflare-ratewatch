[Unit]
Description=cf-ratewatch: ban IPs over an hourly request limit on Cloudflare
Documentation=https://github.com/paveldvoinos/cloudflare-ratewatch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/cf-ratewatch/cf_ratewatch.py -c /etc/cf-ratewatch/config.toml run
User=cf-ratewatch
Group=cf-ratewatch
# The API token is handed over as a systemd credential and picked up automatically.
LoadCredential=cf_api_token:/etc/cf-ratewatch/token
# InfluxDB token, if your influx_url needs one (also picked up automatically):
#LoadCredential=influx_token:/etc/cf-ratewatch/influx_token
# /var/lib/cf-ratewatch for metrics_file, readable by node_exporter:
# run it with --collector.textfile.directory=/var/lib/cf-ratewatch
StateDirectory=cf-ratewatch
StateDirectoryMode=0755
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
